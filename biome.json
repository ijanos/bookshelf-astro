{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.json",
      "src/**/*.cjs",
      "src/**/*.astro",
      "*.js",
      "*.mjs",
      "*.cjs",
      "*.json",
      "!package-lock.json",
      "!src/data/bookshelf.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "tailwind": {
    "stylesheet": "src/styles/global.css"
  },
  "overrides": [
    {
      "includes": ["**", "!src/**/*.astro"],
      "linter": {
        "rules": {
          "preset": "recommended",
          "a11y": "on",
          "complexity": "on",
          "correctness": "on",
          "suspicious": "on",
          "performance": "on",
          "security": "on",
          "style": {
            "noTernary": "off",
            "useImportsFirst": "warn",
            "useReduceTypeParameter": "warn"
          },
          "nursery": "on"
        }
      }
    },
    {
      "includes": ["src/**/*.astro"],
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "nursery": {
            "noAstroConflictingSetDirectives": "error",
            "useAstroClientOnlyDirectiveValue": "error",
            "noTailwindLegacyUtilities": "warn",
            "useTailwindShorthandClasses": "warn",
            "useTailwindStaticClassStrings": "warn"
          }
        }
      }
    }
  ]
}
