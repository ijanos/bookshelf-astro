{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.json",
      "src/**/*.cjs",
      "*.js",
      "*.mjs",
      "*.cjs",
      "*.json",
      "!package-lock.json",
      "!src/data/bookshelf.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "on",
      "complexity": "on",
      "correctness": "on",
      "suspicious": "on",
      "performance": "on",
      "security": "on",
      "style": {
        "noTernary": "off"
      },
      "nursery": "on"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
