    "astro": "^7",
    "d3": "^7.9.0",
    "string-to-color": "^2.2.2",
    "tailwindcss": "^4.0.2",
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.13.5",
    "@types/d3": "^7.4.3",
    "@types/node": "^24",
    "tslib": "^2.8.1",
    "wrangler": "^4.0.0"
